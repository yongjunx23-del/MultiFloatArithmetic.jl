# Float64x3/Float32x3 fma_fast accumulation network.
# See verification/README.md for the modeling contract.

variable x0
variable x1
variable x2
variable y0
variable y1
variable y2
variable c0
variable c1
variable c2

assume x0 strongly_dominates x1
assume x1 strongly_dominates x2
assume y0 strongly_dominates y1
assume y1 strongly_dominates y2
assume c0 strongly_dominates c1
assume c1 strongly_dominates c2

variable p00
variable e00
two_prod x0 y0 p00 e00

variable p01
variable e01
two_prod x0 y1 p01 e01

variable p10
variable e10
two_prod x1 y0 p10 e10

# Rounded one-product terms. Their exact residuals are deliberately dropped.
variable p02
variable e02
two_prod x0 y2 p02 e02

variable p11
variable e11
two_prod x1 y1 p11 e11

variable p20
variable e20
two_prod x2 y0 p20 e20

# sigma = (p02 + p20) + p11
two_sum p02 p20
two_sum p02 p11

# tail = ((e01 + e10) + sigma) + c2
two_sum e01 e10
two_sum e01 p02
two_sum e01 c2

# a, q1 = two_sum(p01, p10)
# a, q2 = two_sum(a, e00)
# a, q3 = two_sum(a, c1)
two_sum p01 p10
two_sum p01 e00
two_sum p01 c1

# tail += (q1 + q2) + q3
two_sum p10 e00
two_sum p10 c1
two_sum e01 p10

# b, r = two_sum(p00, c0)
# m1, m2 = two_sum(r, a)
# m2 += tail
two_sum p00 c0
two_sum c0 p01
two_sum p01 e01

# First output compression.
fast_two_sum p00 c0
two_sum      c0 p01
two_sum      p00 c0
fast_two_sum c0 p01

# Proof-driven minimal repair selected by the A/B in draft PR #9.
two_sum      p00 c0
fast_two_sum c0 p01

prove p00 strongly_dominates c0
prove c0 strongly_dominates p01
