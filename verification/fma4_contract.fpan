# x4 final-compression contract. The three pre-compression terms are proved in
# fma4_stage1/2/3.fpan. This small network checks both explicit FastTwoSum
# preconditions and the final output non-overlap chain.

variable b
variable a1
variable a2
variable a3

assume b strongly_dominates a1
assume a1 strongly_dominates a2
assume a2 strongly_dominates a3

# w0, w1 = fast_two_sum(b, a1)
# w1, w2 = two_sum(w1, a2)
# w2, w3 = two_sum(w2, a3)
# z0, rho = two_sum(w0, w1)
# z1, sigma = two_sum(rho, w2)
# z2, z3 = fast_two_sum(sigma, w3)
fast_two_sum b a1
two_sum      a1 a2
two_sum      a2 a3
two_sum      b a1
two_sum      a1 a2
fast_two_sum a2 a3

prove b strongly_dominates a1
prove a1 strongly_dominates a2
prove a2 strongly_dominates a3
