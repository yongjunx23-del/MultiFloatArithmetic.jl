# x4 compositional proof stage 1: prove that the leading accumulator b
# strongly dominates a1 before the final four-limb compression.

variable x0
variable x1
variable y0
variable y1
variable c0
variable c1

assume x0 strongly_dominates x1
assume y0 strongly_dominates y1
assume c0 strongly_dominates c1

variable p00
variable e00
two_prod x0 y0 p00 e00

variable p01
variable e01
two_prod x0 y1 p01 e01

variable p10
variable e10
two_prod x1 y0 p10 e10

# b, r = two_sum(p00, c0)
two_sum p00 c0

# a1, f1 = two_sum(p01, p10)
# a1, f2 = two_sum(a1, e00)
# a1, f3 = two_sum(a1, c1)
# a1, f4 = two_sum(a1, r)
two_sum p01 p10
two_sum p01 e00
two_sum p01 c1
two_sum p01 c0

prove p00 strongly_dominates p01
